; projects/kv/tests/hot-squeeze.aura — IN-PROCESS policy grid (one Aura process)
;
; Fully leverages single-process eval: no per-policy cold start.
; Optional fiber fanout for pure load waves after pick.
;
; Env: UNIFY_LOAD_KEYS UNIFY_LOAD_OPS UNIFY_HOT_FIBER_N
; Emits: BEST_POLICY / LOAD_SCORE_TOTAL / RESULT pass project=kv-hot-squeeze

(require "kv" all:)
(require "kv-engine" all:)

(let* ((now-ms (lambda () (try (current-time-ms) (catch (e) 0))))
       (env-keys (getenv "UNIFY_LOAD_KEYS"))
       (env-ops (getenv "UNIFY_LOAD_OPS"))
       (env-fn (getenv "UNIFY_HOT_FIBER_N"))
       (N-KEYS
         (let ((n (if (and (string? env-keys) (> (string-length env-keys) 0))
                    (string->number env-keys) #f)))
           (if (and (number? n) (> n 0)) n 48)))
       (N-OPS
         (let ((n (if (and (string? env-ops) (> (string-length env-ops) 0))
                    (string->number env-ops) #f)))
           (if (and (number? n) (> n 0)) n 160)))
       (FIBER-N
         (let ((n (if (and (string? env-fn) (> (string-length env-fn) 0))
                    (string->number env-fn) #f)))
           (if (and (number? n) (> n 0)) n 16)))
       (fill
         (lambda (n pol)
           (let ((i 0) (e (kv:engine-open pol)))
             (while (lambda () (< i n))
               (lambda ()
                 (set! e (kv:engine-set e
                           (string-append "k" (number->string i)) i))
                 (set! i (+ i 1))))
             e)))
       (hotspot
         (lambda (e n-ops hot-n)
           (let ((i 0) (eng e))
             (while (lambda () (< i n-ops))
               (lambda ()
                 (let ((r (kv:engine-get eng
                            (string-append "k" (number->string (modulo i hot-n))))))
                   (set! eng (cadr r))
                   (set! i (+ i 1)))))
             eng)))
       (uniform
         (lambda (e n-ops n-keys)
           (let ((i 0) (eng e))
             (while (lambda () (< i n-ops))
               (lambda ()
                 (let ((r (kv:engine-get eng
                            (string-append "k" (number->string (modulo i n-keys))))))
                   (set! eng (cadr r))
                   (set! i (+ i 1)))))
             eng)))
       (mixed
         (lambda (e n-ops n-keys)
           (let ((i 0) (eng e))
             (while (lambda () (< i n-ops))
               (lambda ()
                 (if (= (modulo i 5) 0)
                   (set! eng (kv:engine-set eng
                               (string-append "k" (number->string (modulo i n-keys)))
                               i))
                   (let ((r (kv:engine-get eng
                              (string-append "k" (number->string (modulo i n-keys))))))
                     (set! eng (cadr r))))
                 (set! i (+ i 1))))
             eng)))
       (bench-pol
         (lambda (mode csize thr)
           (let* ((pol (list mode csize thr))
                  (base (fill N-KEYS pol))
                  (hot-n (if (< 4 N-KEYS) 4 N-KEYS))
                  (t0 (now-ms))
                  (_1 (hotspot base N-OPS hot-n))
                  (t1 (now-ms))
                  (_2 (uniform base N-OPS N-KEYS))
                  (t2 (now-ms))
                  (_3 (mixed base N-OPS N-KEYS))
                  (t3 (now-ms))
                  (e1 (if (> (- t1 t0) 0) (- t1 t0) 1))
                  (e2 (if (> (- t2 t1) 0) (- t2 t1) 1))
                  (e3 (if (> (- t3 t2) 0) (- t3 t2) 1))
                  (s (+ (/ (* N-OPS 1000) e1)
                        (/ (* N-OPS 1000) e2)
                        (/ (* N-OPS 1000) e3))))
             (display "HOT mode=") (display mode)
             (display " cache=") (display csize)
             (display " thr=") (display thr)
             (display " score=") (display s)
             (newline)
             s)))
       ; grid as flat lists (avoid deep recursion building)
       (modes (list "hybrid" "cache" "alist"))
       (caches (list 4 8 16 32 48))
       (thrs (list 16 32 64))
       (best-s -1)
       (best-mode "hybrid")
       (best-c 8)
       (best-t 32)
       (n-tried 0)
       (t-grid0 (now-ms)))

  (display "=== kv hot-squeeze (in-process) keys=") (display N-KEYS)
  (display " ops=") (display N-OPS)
  (display " fiber-n=") (display FIBER-N)
  (display " backend=") (display (try (fiber:spawn-backend) (catch (e) -1)))
  (newline)

  ; ── sequential grid in ONE process (no cold start per cell) ─────────────
  ; alist once
  (let ((s (bench-pol "alist" 0 9999)))
    (set! n-tried (+ n-tried 1))
    (if (> s best-s)
      (begin (set! best-s s) (set! best-mode "alist")
             (set! best-c 0) (set! best-t 9999))
      #f))
  ; hybrid + cache × caches × thrs
  (let ((ms (list "hybrid" "cache")))
    (while (lambda () (pair? ms))
      (lambda ()
        (let ((mode (car ms))
              (cs caches))
          (while (lambda () (pair? cs))
            (lambda ()
              (let ((c (car cs))
                    (ts thrs))
                (while (lambda () (pair? ts))
                  (lambda ()
                    (let ((thr (car ts))
                          (s (bench-pol mode c thr)))
                      (set! n-tried (+ n-tried 1))
                      (if (> s best-s)
                        (begin (set! best-s s) (set! best-mode mode)
                               (set! best-c c) (set! best-t thr))
                        #f)
                      (set! ts (cdr ts)))))
                (set! cs (cdr cs)))))
          (set! ms (cdr ms))))))

  (let ((t-grid1 (now-ms)))
    (display "GRID_MS ") (display (if (> (- t-grid1 t-grid0) 0) (- t-grid1 t-grid0) 0))
    (display " tried=") (display n-tried)
    (newline))

  (display "BEST_POLICY mode=") (display best-mode)
  (display " cache=") (display best-c)
  (display " thr=") (display best-t)
  (display " score=") (display best-s)
  (newline)
  (display "LOAD_SCORE_TOTAL ") (display best-s) (newline)

  ; ── fiber soak: flat fanout readers on best policy (no nested join) ─────
  (let* ((pol (list best-mode best-c best-t))
         (shared (fill N-KEYS pol))
         (want (let loop ((i 0) (acc 0))
                 (if (>= i N-KEYS) acc (loop (+ i 1) (+ acc i)))))
         (reader
           (lambda ()
             (let ((i 0) (acc 0) (eng shared))
               (while (lambda () (< i N-KEYS))
                 (lambda ()
                   (let ((r (kv:engine-get eng
                              (string-append "k" (number->string i)))))
                     (set! eng (cadr r))
                     (if (number? (car r)) (set! acc (+ acc (car r))) #f)
                     (set! i (+ i 1)))))
               acc)))
         (ids (quote ()))
         (k 0)
         (ok-spawn #t)
         (t-f0 (now-ms)))
    (while (lambda () (and ok-spawn (< k FIBER-N)))
      (lambda ()
        (let ((fid (fiber:spawn reader)))
          (if (and (number? fid) (> fid 0))
            (begin (set! ids (cons fid ids)) (set! k (+ k 1)))
            (set! ok-spawn #f)))))
    (let ((xs ids) (n-ok 0) (all-ok #t))
      (while (lambda () (pair? xs))
        (lambda ()
          (let ((r (fiber:join (car xs))))
            (if (and (number? r) (= r want))
              (set! n-ok (+ n-ok 1))
              (set! all-ok #f))
            (set! xs (cdr xs)))))
      (let ((t-f1 (now-ms)))
        (display "FIBER_SOAK n=") (display FIBER-N)
        (display " n-ok=") (display n-ok)
        (display " ms=") (display (if (> (- t-f1 t-f0) 0) (- t-f1 t-f0) 0))
        (display " ok=") (display all-ok)
        (newline)
        (if (and ok-spawn all-ok)
          (display "  PASS fiber-soak")
          (display "  FAIL fiber-soak"))
        (newline))))

  (display "RESULT pass project=kv-hot-squeeze mode=")
  (display best-mode)
  (display " cache=") (display best-c)
  (display " thr=") (display best-t)
  (display " score=") (display best-s)
  (display " tried=") (display n-tried)
  (newline))
