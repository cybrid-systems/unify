; lib/unify-min.aura — facade (measure + loop + host + compose)
; Form order: export before require.

(export unify:stats unify:stats-reset! unify:stats-ref unify:stats-bump!
        unify:stats-set! unify:stats-alist unify:alist-ref
        unify:check-eq unify:check-true unify:check-ge
        unify:escape-note!
        unify:loop-version unify:min-version
        unify:install-subject unify:safety-ok?
        unify:snapshot unify:restore unify:rebind-safe
        unify:observe-score unify:verify-score
        unify:propose-body! unify:loop-once!
        unify:host-version
        unify:classify-signal unify:host-flag! unify:fingerprint
        unify:git-rev unify:git-branch unify:git-status-short
        unify:git-log-oneline unify:git-diff-text
        unify:git-probe! unify:git-stage-safe! unify:git-commit-safe!
        unify:compose-version
        unify:compose-span-versions
        unify:compose-aether! unify:compose-hephaestus!
        unify:compose-prometheus! unify:compose-hermes!
        unify:compose-all! unify:compose-ok?)

(require "unify-measure" all:)
(require "unify-loop" all:)
(require "unify-host" all:)
(require "unify-compose" all:)

(define unify:min-version 2)
